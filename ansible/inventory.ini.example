# Example Ansible inventory. Copy to `inventory.ini` (git-ignored) and set the
# target Pi's IP. SSH keys must be pre-exchanged.
[imx462]
pi0 ansible_host=192.168.1.100 ansible_user=root

[imx462:vars]
ansible_python_interpreter=/usr/bin/python3
# number of cameras to configure: 1 or 2
imx462_camera_count=1
