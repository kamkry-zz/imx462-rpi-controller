[Unit]
Description=IMX462 RPi Camera Controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ imx462_service_user }}
WorkingDirectory={{ imx462_app_dir }}
ExecStart={{ imx462_venv }}/bin/imx462-controller
Restart=on-failure
RestartSec=5
# Long enough to remux an active recording to MP4 on shutdown (ffmpeg's own
# timeout is 120 s); the systemd default of 90 s could SIGKILL mid-remux.
TimeoutStopSec=180
EnvironmentFile={{ imx462_app_dir }}/.env
# Memory guard: an OOM kill inside this cgroup restarts the service
# (Restart=on-failure) instead of letting a leak thrash the whole board.
# Requires the memory cgroup controller (cgroup_enable=memory, see role).
MemoryAccounting=yes
MemoryHigh={{ imx462_memory_high }}
MemoryMax={{ imx462_memory_max }}
MemorySwapMax={{ imx462_memory_swap_max }}

[Install]
WantedBy=multi-user.target
