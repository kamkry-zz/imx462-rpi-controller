# Secrets for the IMX462 RPi Controller. Copy to `.env` (git-ignored) and fill in.

# MQTT broker
MQTT_HOST=broker.example.com
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# OpenTelemetry (optional token/auth)
OTEL_EXPORTER_OTLP_HEADERS=

# CA certificate (PEM) path for the OTLP endpoint when it uses a private CA.
# Blank = system CAs. The cert ships as a git-ignored file via the app role.
OTEL_EXPORTER_OTLP_CERTIFICATE=
